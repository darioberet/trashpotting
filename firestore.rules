rules_version = '2';

// Regole di sicurezza Firestore di Trashpotting.
//
// Principi:
// - Si legge solo da autenticati; si scrive solo i campi che l'app tocca
//   davvero, per ogni operazione (vedi lib/repositories/*).
// - Gli admin sono riconosciuti dalla custom claim `admin: true` sul token
//   (impostata con tool/set_admin.js).
// - Un utente bloccato (`users/{uid}.blocked == true`) può ancora leggere
//   ma non creare né modificare contenuti.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isBlocked() {
      let profile = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(profile) && get(profile).data.get('blocked', false) == true;
    }

    // Utente che può creare/modificare contenuti.
    function canContribute() {
      return verified() && !isBlocked();
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── Limite anti-spam: max 10 segnalazioni al giorno (giorno UTC) ────────
    // Ogni nuova segnalazione aggiorna, nello stesso batch, il contatore
    // `users/{uid}.reportQuota = {day, count}`. Le regole su `users`
    // impediscono di azzerarlo; quelle su `reports` esigono che sia stato
    // incrementato. Va tenuto allineato a maxReportsPerDay in
    // lib/repositories/report_repository.dart.
    function maxReportsPerDay() {
      return 10;
    }

    function today() {
      return math.floor(request.time.toMillis() / 86400000);
    }

    function validQuota(before, after) {
      return after is map
        && after.keys().hasOnly(['day', 'count'])
        && after.day == today()
        && after.count <= maxReportsPerDay()
        && ((before != null && before.day == today()
              && after.count == before.count + 1)
            || ((before == null || before.day < today()) && after.count == 1));
    }

    function quotaBumpedInThisWrite() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path)
        && getAfter(path).data.get('reportQuota', null)
             != get(path).data.get('reportQuota', null);
    }

    // Profilo pubblico incorporato nei report (evento, partecipanti, chi
    // pulisce): mai l'email.
    function isOwnProfile(p) {
      return p is map
        && p.keys().hasOnly(['uid', 'username'])
        && p.uid == request.auth.uid;
    }

    // ── Voti della community ("C'è ancora" / "Non c'è più") ────────────────
    // Soglie, da tenere allineate a lib/repositories/report_repository.dart.
    function goneVotesToHide() {
      return 2;
    }

    function reportPath(reportId) {
      return /databases/$(database)/documents/reports/$(reportId);
    }

    function votePath(reportId) {
      return /databases/$(database)/documents/reports/$(reportId)/votes/$(request.auth.uid);
    }

    // Si vota solo sulle segnalazioni ancora da pulire, non sulle proprie.
    function votableReport(report) {
      return report.status in ['segnalata', 'aperta']
        && report.get('uid', null) != request.auth.uid;
    }

    // Entro ~200 m: riquadro di 0.0018° di latitudine (~200 m) e 0.0026° di
    // longitudine (~200 m alle latitudini italiane). L'app controlla la
    // distanza esatta; qui si blocca il voto "dal divano".
    function nearReport(report, vote) {
      return vote.latitude is number && vote.longitude is number
        && math.abs(vote.latitude - report.latitude) <= 0.0018
        && math.abs(vote.longitude - report.longitude) <= 0.0026;
    }

    function communityVote(reportId) {
      let before = resource.data;
      let after = request.resource.data;
      let vote = getAfter(votePath(reportId)).data.vote;
      let confirmations = before.get('confirmations', 0);
      let gone = before.get('goneVotes', 0);
      return changed().hasOnly(['confirmations', 'goneVotes', 'status'])
        && votableReport(before)
        && !exists(votePath(reportId))
        && existsAfter(votePath(reportId))
        && ((vote == 'present'
              && after.get('confirmations', 0) == confirmations + 1
              && after.get('goneVotes', 0) == gone
              && after.status == 'aperta')
            || (vote == 'gone'
              && after.get('goneVotes', 0) == gone + 1
              && after.get('confirmations', 0) == confirmations
              && ((gone + 1 >= goneVotesToHide() && after.status == 'sparita')
                  || (gone + 1 < goneVotesToHide()
                      && after.status == before.status))));
    }

    // ── Profili ────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn();

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['username', 'updatedAt', 'createdAt', 'onboardingComplete',
              'termsAcceptedAt', 'termsVersion']);

      // Il proprietario aggiorna il proprio profilo ma non lo stato di
      // blocco; l'admin aggiorna solo lo stato di blocco.
      allow update: if
        (signedIn() && request.auth.uid == uid
          && !changed().hasAny(['blocked', 'blockedAt', 'blockedBy'])
          && request.resource.data.keys().hasOnly(
               ['username', 'updatedAt', 'createdAt', 'onboardingComplete',
                'blocked', 'blockedAt', 'blockedBy', 'reportQuota',
                'termsAcceptedAt', 'termsVersion'])
          && (!changed().hasAny(['reportQuota'])
              || validQuota(resource.data.get('reportQuota', null),
                            request.resource.data.reportQuota)))
        || (isAdmin()
          && changed().hasOnly(['blocked', 'blockedAt', 'blockedBy']));

      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
          && changed().hasOnly(['read']);
      }
    }

    // ── Segnalazioni ───────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if signedIn();

      allow create: if canContribute()
        && quotaBumpedInThisWrite()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'segnalata'
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.keys().hasOnly(
             ['note', 'photoUrl', 'latitude', 'longitude', 'geohash', 'uid',
              'status', 'type', 'address', 'createdAt']);

      allow update: if canContribute() && (
        // "Voglio pulire questa zona" / "Passa a pulizia in corso".
        (changed().hasOnly(['status', 'cleaningOwner', 'cleaningStartedAt'])
          && request.resource.data.status == 'puliziaInCorso'
          && isOwnProfile(request.resource.data.cleaningOwner)
          && resource.data.get('cleaningOwner', null) == null
          && (resource.data.get('event', null) == null
              || resource.data.event.creator.uid == request.auth.uid))
        // Pulizia completata con foto finale.
        || (changed().hasOnly(['status', 'cleanupPhotoUrl', 'cleanedAt'])
          && request.resource.data.status == 'ripulita'
          && resource.data.get('cleaningOwner', null) != null
          && resource.data.cleaningOwner.uid == request.auth.uid)
        // Creazione evento di pulizia.
        || (changed().hasOnly(['status', 'event'])
          && request.resource.data.status == 'eventoCreato'
          && resource.data.get('event', null) == null
          && isOwnProfile(request.resource.data.event.creator))
        // Partecipazione: cambia solo l'elenco partecipanti, aggiungendo sé
        // stessi.
        || (changed().hasOnly(['event'])
          && resource.data.get('event', null) != null
          && request.resource.data.event.creator == resource.data.event.creator
          && request.resource.data.event.scheduledAt == resource.data.event.scheduledAt
          && request.resource.data.event.participants.size()
               == resource.data.event.participants.size() + 1)
        // Voto della community: aggiorna contatori e stato insieme al
        // documento votes/{uid} creato nella stessa scrittura.
        || communityVote(reportId)
      )
      // Admin: ripristina una segnalazione "sparita".
      || (isAdmin()
          && resource.data.status == 'sparita'
          && changed().hasOnly(['status', 'goneVotes'])
          && request.resource.data.status in ['segnalata', 'aperta']
          && request.resource.data.goneVotes == 0)
      // Eliminazione account: l'autore anonimizza le proprie segnalazioni
      // (consentito anche se bloccato).
      || (signedIn()
          && changed().hasOnly(['uid'])
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == null);

      allow delete: if isAdmin();

      // Un voto per utente e segnalazione, solo vicino al punto e mai sulle
      // proprie. Id del documento = uid di chi vota.
      match /votes/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow list: if isAdmin();
        allow create: if canContribute()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(
               ['vote', 'latitude', 'longitude', 'createdAt'])
          && request.resource.data.vote in ['present', 'gone']
          && votableReport(get(reportPath(reportId)).data)
          && nearReport(get(reportPath(reportId)).data, request.resource.data)
          && getAfter(reportPath(reportId)).data.get('confirmations', 0)
               + getAfter(reportPath(reportId)).data.get('goneVotes', 0)
             == get(reportPath(reportId)).data.get('confirmations', 0)
               + get(reportPath(reportId)).data.get('goneVotes', 0) + 1;
      }
    }

    // Archivio delle segnalazioni rimosse dagli admin.
    match /removedReports/{reportId} {
      allow read, write: if isAdmin();
    }

    // ── Classifica ─────────────────────────────────────────────────────────
    // Ognuno scrive solo la propria riga, aumentando i punti di 1 o 2 per
    // volta (segnalazione / pulizia). Il limite è sulla singola scrittura:
    // impedire ripetizioni abusive richiederebbe una Cloud Function.
    match /leaderboard/{uid} {
      allow read: if signedIn();

      allow create: if canContribute() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'points'])
        && request.resource.data.points in [1, 2];

      allow update: if canContribute() && request.auth.uid == uid
        && changed().hasOnly(['username', 'points'])
        && request.resource.data.points - resource.data.get('points', 0)
             in [0, 1, 2];

      allow delete: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // ── Contenuti segnalati dagli utenti (moderazione) ─────────────────────
    // Id = `{reportId}_{uid}`: una sola segnalazione per utente e report.
    match /flags/{flagId} {
      // Leggere la propria segnalazione (o verificare che non esista ancora)
      // serve all'app per non far segnalare due volte lo stesso contenuto.
      allow get: if isAdmin()
        || (signedIn() && (resource == null
              || resource.data.reporterUid == request.auth.uid));
      allow list, update, delete: if isAdmin();

      allow create: if canContribute()
        && flagId == request.resource.data.reportId + '_' + request.auth.uid
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 300
        && request.resource.data.keys().hasOnly(
             ['reportId', 'reporterUid', 'reportAuthorUid', 'reason',
              'status', 'createdAt']);
    }
  }
}
